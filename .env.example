# Backend API (backend/server.js) and website (frontend/server.js) run as separate servers.
# The website forwards /api/* to API_URL, so APP_URL is the website address users open.
API_PORT=4000
FRONTEND_PORT=3000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Generate a long random value, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Gmail password-reset email (use a Google App Password, not your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-address@gmail.com

# Social sign-in. Add the callback URLs below in each provider console:
# Google: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID credentials. APPLE_CLIENT_SECRET is Apple's generated client-secret JWT.
# Apple: http://localhost:3000/api/auth/oauth/apple/callback (production HTTPS is required by Apple)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# MongoDB for user accounts, e.g. mongodb+srv://user:password@cluster.mongodb.net/motor_vision
# Leave blank to keep accounts in backend/data/users.json
DATABASE_URL=

# Internal URL for the future Python inference service (not connected yet)
ML_API_URL=http://127.0.0.1:8000

# Optional Python executable for Component 02 (LightGBM + SHAP recommendations).
# Defaults to %USERPROFILE%/anaconda3/python.exe when present, otherwise python.
# Example: RECOMMENDATION_PYTHON=C:/path/to/venv/Scripts/python.exe
RECOMMENDATION_PYTHON=
